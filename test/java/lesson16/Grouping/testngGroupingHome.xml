<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="GroupingSuite">
    <test name="FirstGroup">
        <groups>
            <run>
                <include name="first"/>
            </run>
        </groups>
        <classes>
            <class name="lesson16.Grouping.Groups">
                <methods>
                    <include name="one"/>
                    <include name="three"/>
                    <include name="five"/>
                    <include name="seven"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="SecondGroup">
        <groups>
            <run>
                <include name="second"/>
            </run>
        </groups>
        <classes>
            <class name="lesson16.Grouping.Groups">
                <methods>
                    <include name="two"/>
                    <include name="four"/>
                    <include name="six"/>
                    <include name="eight"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
